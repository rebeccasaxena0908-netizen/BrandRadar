# Copy to .env and fill in. Never commit .env.

# MySQL / MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brand_radar
DB_USER=radar
DB_PASSWORD=change-me

# Collector
FETCH_INTERVAL_MINUTES=60
FETCH_SINCE_DAYS=30
MAX_ITEMS_PER_SOURCE=500
APPSTORE_COUNTRIES=us,in,gb,ca,au
PLAYSTORE_LANG=en
PLAYSTORE_COUNTRY=us

# HTTP politeness
HTTP_TIMEOUT=15
HTTP_RETRIES=3
HTTP_MIN_INTERVAL=0.5
HTTP_USER_AGENT=BrandRadar/0.2 (brand sentiment research)

# NLP pipeline
NLP_BATCH_SIZE=8
NLP_MAX_TOKENS=512
# bart-large zero-shot is the slow, memory-hungry part; the start of a text is enough for it
NLP_ZERO_SHOT_MAX_TOKENS=256
NLP_DEVICE=auto
FEATURE_THRESHOLD=0.5

# Topics (BERTopic) — small data
TOPIC_MIN_COMPLAINTS=30
TOPIC_MIN_SIZE=5
TOPIC_OUTLIER_SIMILARITY=0.5

# Priority matrix: volume = complaint mentions in the last 7 days, pain = negativity x anger/disgust
PRIORITY_VOLUME_THRESHOLD=5
PRIORITY_PAIN_THRESHOLD=0.15

# Alerts: this week / last week >= ratio, with at least N mentions this week
ALERT_TREND_RATIO=2.0
ALERT_MIN_MENTIONS=5

# Reddit (optional — leave blank to skip the source)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brand-radar/0.1
