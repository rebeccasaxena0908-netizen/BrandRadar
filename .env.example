# Copy to .env and fill in. Never commit .env.

# MySQL / MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brand_radar
DB_USER=radar
DB_PASSWORD=change-me

# Collector
FETCH_INTERVAL_MINUTES=60

# Priority / alerts
ALERT_TREND_RATIO=2.0
ALERT_MIN_MENTIONS=5

# Reddit (optional — leave blank to skip the source)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=brand-radar/0.1
