# Copy to .env and fill in. Never commit .env.

# MySQL / MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brand_radar
DB_USER=radar
DB_PASSWORD=change-me

# Collector
COLLECTOR_INTERVAL_HOURS=6
FETCH_SINCE_DAYS=30
MAX_ITEMS_PER_SOURCE=500
APPSTORE_COUNTRIES=us,in,gb,ca,au
PLAYSTORE_LANG=en
PLAYSTORE_COUNTRY=us

# HTTP politeness
HTTP_TIMEOUT=15
HTTP_RETRIES=3
HTTP_MIN_INTERVAL=0.5
HTTP_USER_AGENT=BrandRadar/0.2 (brand sentiment research)

# NLP pipeline
NLP_BATCH_SIZE=8
NLP_MAX_TOKENS=512
# bart-large zero-shot is the slow, memory-hungry part; the start of a text is enough for it
NLP_ZERO_SHOT_MAX_TOKENS=256
NLP_DEVICE=auto
FEATURE_THRESHOLD=0.5

# Topics (BERTopic) — small data
TOPIC_MIN_COMPLAINTS=30
TOPIC_MIN_SIZE=5
TOPIC_OUTLIER_SIMILARITY=0.5
# Sources that are not user feedback (dev.to: mostly makers writing about their own tools; news:
# headlines) stay out of complaint topics, the priority matrix and alerts; they still count for
# sentiment, radar and clouds
TOPIC_EXCLUDED_SOURCES=devto,news

# Priority matrix: volume = complaint mentions in the last 7 days, pain = negativity x anger/disgust
PRIORITY_VOLUME_THRESHOLD=5
PRIORITY_PAIN_THRESHOLD=0.15
# Dashboard hides praise/discussion topics by default: pain below this and mean sentiment > 0
PRIORITY_PRAISE_PAIN_MAX=0.02

# Alerts: this week / last week >= ratio, with at least N mentions this week
ALERT_TREND_RATIO=2.0
ALERT_MIN_MENTIONS=5

# Demo mode: BRAND_RADAR_DEMO=1 streamlit run app.py reads this database instead (python seed_demo.py)
DEMO_DB_NAME=brand_radar_demo

# Mastodon: public hashtag timelines on these instances (no login)
MASTODON_INSTANCES=mastodon.social,fosstodon.org,hachyderm.io

# Reddit (optional — leave blank to skip the source)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:brand-radar:0.1 (by u/your-reddit-username)

# YouTube Data API v3 (optional — leave blank to skip the source). Free key from Google Cloud Console,
# see README "Enabling YouTube". Quota resets at midnight Pacific time.
YOUTUBE_API_KEY=
# search.list calls per day (Google caps these at 100/day) and other units per day (10,000/day)
YOUTUBE_SEARCH_BUDGET=80
YOUTUBE_UNIT_BUDGET=8000
# per brand and cycle: newest matched videos whose comments are read, and 100-comment pages per video
YOUTUBE_MAX_VIDEOS=30
YOUTUBE_COMMENT_PAGES=2

# News (GDELT, free, no key): GDELT asks for at most one request every 5 seconds
NEWS_MIN_INTERVAL=6

# Notifications (optional, off unless set): new spike alerts after each collector cycle, and the weekly
# PDF report every Monday morning. See README "Notifications". Test with: python -m reports.notify --test
# Email via SMTP. Gmail: smtp.gmail.com, port 587, your address, and a 16-character app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# sender address (defaults to SMTP_USER) and recipients (comma-separated)
SMTP_FROM=
NOTIFY_EMAIL_TO=
# Slack incoming webhook (https://hooks.slack.com/services/...). Slack gets a summary; PDFs go by email.
SLACK_WEBHOOK_URL=
# weekly report: Monday at this hour in this time zone; brands = "own" (each group's own brand), "all" or names
NOTIFY_TIMEZONE=Asia/Kolkata
NOTIFY_WEEKLY_HOUR=8
NOTIFY_WEEKLY_BRANDS=own
# link in the messages
DASHBOARD_URL=http://localhost:8501
